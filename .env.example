# Environment variables template for R2-Uplink
# NODE_ENV: development is the local dev default; set to "production" on the
# EC2/Docker box so env validation hard-fails instead of mock-falling back.
NODE_ENV=development
LOG_LEVEL=info
MAX_UPLOAD_SIZE=524288000
DEFAULT_EXPIRY=86400
UPLOAD_URL_EXPIRY=900
DOWNLOAD_URL_EXPIRY=60

# Standalone server bind address/port (read by `node server.js` in the
# Docker image; ignored by `next dev`). Caddy fronts the app on :80.
HOSTNAME=0.0.0.0
PORT=3000

# Cloudflare R2 Credentials
R2_ACCESS_KEY_ID=cf_access_key_here
R2_SECRET_ACCESS_KEY=cf_secret_key_here
R2_BUCKET_NAME=uplink-bucket
# Format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/r2-uplink?retryWrites=true&w=majority

# Upstash Redis Connection (for Rate Limiting & Idempotency)
UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Encryption / Hashing Secret (used for IP hashing)
IP_ANONYMIZATION_SECRET=change_me_to_a_secure_hmac_key_for_ip_masking

# Trust the x-forwarded-for header for per-IP budgets?
#   "true": trust XFF (run behind your own reverse proxy: nginx, Caddy, …).
#     REQUIRED on the EC2 box — Caddy is the only ingress there and rewrites
#     XFF with the real client IP before the app sees it.
#   unset (default): trust the platform only — on Vercel the proxy overwrites
#     XFF, so it is platform-controlled; anywhere else XFF is ignored.
#   "false": never trust XFF — attacker-controlled — all clients share one
#     budget bucket (anti-abuse stays on, per-IP granularity is lost).
TRUST_PROXY=true

# Cleanup/cron secret. Generate on the box with: openssl rand -hex 32
# Used by the daily systemd cleanup timer (deploy/uplink-cleanup.*) and
# accepted by POST/GET /api/v1/cleanup (share cleanup) as
# "Authorization: Bearer <CRON_SECRET>" in addition to the admin key.
# Note: /api/v1/session/cleanup — the former Vercel cron target — is
# currently unauthenticated.
CRON_SECRET=

# Frontend App URL.
# EC2 (until a domain exists): http://52.7.217.135:3000
# Local dev: http://localhost:3000
APP_URL=http://52.7.217.135:3000
