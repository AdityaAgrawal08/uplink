{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "functions": {
    "src/app/api/v1/session/create/route.ts": { "maxDuration": 10 },
    "src/app/api/v1/session/*/join/route.ts": { "maxDuration": 10 },
    "src/app/api/v1/session/*/heartbeat/route.ts": { "maxDuration": 5 }
  },
  "crons": [
    {
      "path": "/api/v1/session/cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
